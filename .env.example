# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here          # shared key for the free runs (users can also paste their own key in the app)
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Local Postgres (docker compose up -d db). In production set DATABASE_URL instead.
POSTGRES_USER=seo_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=seo_agent
DB_HOST=127.0.0.1
DB_PORT=5434
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_URL=https://your-app.onrender.com       # used for share links and Google sign-in redirects

# Free runs: per user per rolling 24h, and in total for everyone
FREE_RUNS_PER_DAY=2
GLOBAL_FREE_RUNS_PER_DAY=40
MAX_CONCURRENT_RUNS=3

# Optional
# GOOGLE_CLIENT_ID=            # enables "Continue with Google"
# GOOGLE_CLIENT_SECRET=
# PIXABAY_API_KEY=             # optional free key from pixabay.com/api/docs (Pexels has paused new keys)
# IMAGE_MODEL=gemini-2.5-flash-image
# IMAGES_ENABLED=true

# Password reset by email (Gmail API, free). See README "Password reset email".
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=you@gmail.com
